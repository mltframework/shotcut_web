        <qmlclass name="Settings" qml-module-name="org.shotcut.qml" fullname="org.shotcut.qml.Settings" href="qml-org-shotcut-qml-settings.html" status="active" access="public" documented="true" title="Settings" fulltitle="Settings" subtitle="" brief="Persistent application settings, accessed via the settings context property">
