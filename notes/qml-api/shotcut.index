            <qmlproperty name="viewMode" fullname="org.shotcut.qml.Settings.viewMode" href="qml-org-shotcut-qml-settings.html#viewMode-prop" status="active" access="public" documented="true" type="string" attached="false" writable="true" brief="Current view mode of the Playlist panel (e.g. &quot;details&quot;, &quot;icons&quot;)"/>
